# Required: Groq API key for LLM chat functionality
GROQ_API_KEY=your-groq-api-key-here

# Optional: Tapetide MCP bearer token for real Indian (NSE) market data
# If not set, the built-in market simulator is used (recommended for most users)
TAPETIDE_API_KEY=

# Optional: Set to "true" for deterministic mock LLM responses (testing)
LLM_MOCK=false

# Optional: force the market data source regardless of key + clock
#   auto (default) | simulator | tapetide
# MARKET_DATA_SOURCE=auto

# Optional: main.py reads these to locate the SQLite file and the static export
# (both default to repo-root-relative paths)
# DATABASE_PATH=
# FRONTEND_DIR=

# Optional: the start scripts pass this to `uvicorn --port`; the app does not
# read it at runtime (default 8000)
# PORT=8000
